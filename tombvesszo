#include <stdio.h>

void print_array(int tomb[], int meret) {
    for (int i = 0; i < meret; i++) {
        printf("%d", tomb[i]);
        
        // Ha nem az utolsó elemről van szó, teszünk utána vesszőt és szóközt
        if (i < meret - 1) {
            printf(", ");
        }
    }
    // Az utolsó elem után (vagy üres tömb esetén) sortörés
    printf("\n");
}

int main() {
    int szamok[] = {4, 7, 34, 23, 67};
    int n = 5;

    print_array(szamok, n);

    return 0;
}
