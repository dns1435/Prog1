#include <stdio.h>
#include <stdlib.h> 

void print_array(int tomb[], int meret) {
    for (int i = 0; i < meret; i++) {
        printf("%d", tomb[i]);
        if (i < meret - 1) {
            printf(", ");
        }
    }
    printf("\n");
}

void make_absolute(int tomb[], int meret) {
    for (int i = 0; i < meret; i++) {
        if (tomb[i] < 0) {
            tomb[i] = abs(tomb[i]);
        }
    }
}

int main() {
    int szamok[] = {-5, 12, 0, -8, -21, 7};
    int n = 6;

    printf("Eredeti tomb: ");
    print_array(szamok, n);

    make_absolute(szamok, n);

    printf("Modositott tomb: ");
    print_array(szamok, n);

    return 0;
}
