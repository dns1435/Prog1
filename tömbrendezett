#include <stdio.h>

int is_sorted(int tomb[], int meret) {
    if (meret <= 1) {
        return 1;
    }

    for (int i = 0; i < meret - 1; i++) {
        if (tomb[i] > tomb[i + 1]) {
            return 0;
        }
    }

    return 1;
}

int main() {
    int t1[] = {1, 2, 4, 7, 10};
    int t2[] = {3, 8, 2, 9, 1};
    int t3[] = {5, 5, 8, 12, 12};
    int t4[] = {}; 

    int n1 = 5, n2 = 5, n3 = 5, n4 = 0;

    printf("t1 {1, 2, 4, 7, 10} rendezett? %d\n", is_sorted(t1, n1));
    printf("t2 {3, 8, 2, 9, 1} rendezett? %d\n", is_sorted(t2, n2));
    printf("t3 {5, 5, 8, 12, 12} rendezett? %d\n", is_sorted(t3, n3));
    printf("t4 {} (ures) rendezett? %d\n", is_sorted(t4, n4));

    return 0;
}
